# ─── SEO Analyzer Configuration ───────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# App
DEBUG=true

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./seo_analyzer.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/seo_analyzer

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Choose which LLM powers the recommendations:
#   "groq"      → Free tier, fast inference (Llama 3.3 70B)
#   "anthropic" → Paid, highest quality (Claude Sonnet 4)
LLM_PROVIDER=groq

# ─── API Keys ─────────────────────────────────────────────────────────────────

# Groq API Key (FREE - get at https://console.groq.com/keys)
GROQ_API_KEY=gsk_...your-key-here...
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude API Key (paid - higher quality recommendations)
ANTHROPIC_API_KEY=sk-ant-...your-key-here...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_BASE_URL=

# Google PageSpeed Insights API Key (OPTIONAL - free, 25,000 requests/day)
# Without this, performance analysis uses HTML-based heuristics (still works, just less accurate)
# To get one (takes 2 minutes): https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# CORS Origins (comma-separated list of allowed frontend URLs)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Vector Store (ChromaDB) - persisted to disk, no external service needed
CHROMA_PERSIST_DIR=./chroma_db
